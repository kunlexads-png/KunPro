# Backend Server Environment Variables
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000","https://cerebrobi.io"]

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/cerebro_bi

# JWT Security
JWT_SECRET_KEY=generate_a_secure_random_256_bit_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Integration (Google Gemini API)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
